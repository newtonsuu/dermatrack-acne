# ============================================================
# DermaTrack — root .gitignore
# ============================================================

# ====== Flutter / Dart build artifacts ======
# Belt-and-suspenders with app/.gitignore.
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.pub-cache/
app/.pub/
app/coverage/
app/**/.last_build_id

# ====== Supabase CLI local state ======
# Project ref, linked-project, and version pins the CLI writes locally.
# Machine/login-specific — not source.
**/supabase/.temp/

# ====== Python (the spike) ======
spike/.venv/
spike/__pycache__/
spike/**/__pycache__/
**/*.pyc

# ====== Spike outputs (PRIVATE — contains face photos and raw API responses) ======
# Selfies used during the API spike. Even if they're stock photos, keeping
# them out of the repo is the safer default. Remove these lines if you
# decide to commit them as research artifacts.
spike/sample_images/
spike/responses/

# ====== Hugging Face local cache ======
# transformers downloads ~350 MB of model weights on first run. Way too
# big for a repo; lives in the user's home cache dir anyway.
.cache/

# ====== CRITICAL — anywhere credentials might land ======
# VS Code launch.json contains --dart-define=SUPABASE_URL/ANON_KEY if you
# ever set it up. Block before it can be committed.
.vscode/launch.json
.vscode/*.local

# Any .env files. Don't commit secrets.
.env
.env.local
.env.*.local

# Roboflow / HF tokens you might paste into a config file for testing.
**/secrets.json
**/secrets.dart
**/config.local.dart

# ====== IDE / editor noise ======
# Note: not ignoring all of .vscode/ since you may want to share
# tasks.json or settings.json (but launch.json is blocked above).
.idea/
*.iml
*.ipr
*.iws

# ====== OS junk ======
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
