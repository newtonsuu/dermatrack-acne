        <!-- Yes issue: evaluate -->
        <mxCell id="v22" value="Evaluate Issue" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="230" width="200" height="60" as="geometry"/></mxCell>

        <!-- Break-glass decision -->
        <mxCell id="v23" value="Is break-glass access&#xa;justified?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dce8f5;strokeColor=#336699;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="340" width="200" height="80" as="geometry"/></mxCell>

        <!-- Deny break-glass (left) -->
        <mxCell id="v24" value="Deny Break-Glass Access" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="200" height="60" as="geometry"/></mxCell>
