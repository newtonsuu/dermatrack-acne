        <mxCell id="cnt_b" value="Continued from Figure 3.X.a" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="315" y="20" width="170" height="40" as="geometry"/></mxCell>

        <!-- Nodes shifted up by 1610 from original positions -->
        <!-- v20: original y=1710 → new y=100 -->
        <mxCell id="v20" value="Does an issue require&#xa;administrative review?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dce8f5;strokeColor=#336699;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="200" height="80" as="geometry"/></mxCell>

        <!-- No issue: record action (left) -->
        <mxCell id="v21" value="Record Review Action&#xa;in Audit Log (if applicable)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="60" as="geometry"/></mxCell>
