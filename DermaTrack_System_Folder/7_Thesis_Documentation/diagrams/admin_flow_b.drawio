<mxfile host="app.diagrams.net" modified="2026-06-27" agent="Claude" version="21.0">
  <diagram id="admin-b" name="Figure 3.X.b Admin Audit Review and Break-Glass Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

