        <!-- Expiry decision -->
        <mxCell id="v29" value="Has break-glass access&#xa;expired or been revoked?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dce8f5;strokeColor=#336699;fontSize=10;" vertex="1" parent="1"><mxGeometry x="300" y="810" width="200" height="80" as="geometry"/></mxCell>

