        </mxCell>

        <mxCell id="v6" value="Is the user role&#xa;Dermatologist?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dce8f5;strokeColor=#336699;fontSize=10;" vertex="1" parent="1">
